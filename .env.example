# Generated by bun run config:example. Copy selected overrides into .env.local; never overwrite an existing secret file.
# VITE_* values are PUBLIC build-time settings. All defaults preserve current behavior.
# Missing/blank LTA keys intentionally keep keyless cameras/weather usable. Set a real LTA_ACCOUNT_KEY for all LTA feeds.


# --- server settings ---
# Private LTA DataMall AccountKey. Empty keeps keyless camera/weather mode. Never prefix secrets with VITE_.
LTA_ACCOUNT_KEY=
# Legacy alias. LTA_ACCOUNT_KEY takes precedence; leave empty for new setups.
LTA_API_KEY=
# LTA provider base; credentials are sent here. Configure only a trusted provider.
LTA_BASE_URL=https://datamall2.mytransport.sg/ltaodataservice
# Keyless data.gov.sg v2 real-time API base.
DATA_GOV_BASE_URL=https://api-open.data.gov.sg/v2/real-time/api
# LTA/image request timeout in milliseconds.
REQUEST_TIMEOUT_MS=15000
# Weather upstream request timeout in milliseconds.
DATA_GOV_TIMEOUT_MS=10000
# Per-upstream health probe timeout in milliseconds.
HEALTH_PROBE_TIMEOUT_MS=8000
# Linear LTA retry backoff in milliseconds.
LTA_RETRY_DELAY_MS=400
# Attempts per ordinary paginated LTA request.
LTA_MAX_ATTEMPTS=3
# Ordinary dataset concurrency; capped at 10 to avoid LTA overload.
LTA_PAGE_CONCURRENCY=6
# Safety cap for ordinary LTA datasets.
LTA_MAX_PAGES=40
# Speed-band concurrency; capped at 10 after observed upstream throttling.
SPEED_PAGE_CONCURRENCY=10
# Attempts per speed-band page.
SPEED_MAX_ATTEMPTS=4
# Safety cap for the complete speed-band dataset.
SPEED_MAX_PAGES=600
# In-process speed cache lifetime in milliseconds; CDN profile follows it.
SPEED_CACHE_TTL_MS=300000
# Delay before the single retry on a weather HTTP 429.
DATA_GOV_RETRY_DELAY_MS=1500
# Scale live-feed CDN cache/stale windows; 0 disables CDN reuse. Default 1 preserves existing profiles.
CDN_CACHE_MULTIPLIER=1
# Immutable camera-image HTTP/CDN cache seconds; capped at the 15-minute signed-link lifetime.
IMAGE_CACHE_SECONDS=900
# Allowed browser origin, or * for the existing public API behavior.
API_CORS_ORIGIN=*

# --- public settings ---
# Public canonical site origin used in build-time social metadata. Rebuild after changing VITE_ values.
VITE_SITE_URL=https://live-traffic-carbon-bc04.vercel.app
# Public keyless traffic-images fallback used by browser and server.
VITE_TRAFFIC_IMAGES_URL=https://api.data.gov.sg/v1/transport/traffic-images
# Expressway speeds, incidents and VMS refresh interval in milliseconds.
VITE_LIVE_POLL_MS=60000
# Camera photo list refresh interval in milliseconds.
VITE_CAMERA_POLL_MS=30000
# Travel times and camera speed-summary refresh interval in milliseconds.
VITE_TRAVEL_TIME_POLL_MS=120000
# Two-hour rain forecast refresh interval in milliseconds.
VITE_RAIN_POLL_MS=300000
# 24-hour forecast refresh interval in milliseconds.
VITE_FORECAST24H_POLL_MS=900000
# Air-quality refresh interval in milliseconds.
VITE_AIR_POLL_MS=600000
# Lightning/heat-stress refresh interval in milliseconds.
VITE_WEATHER_ALERTS_POLL_MS=180000
# Road works and traffic-light refresh interval in milliseconds.
VITE_ROAD_CONDITIONS_POLL_MS=300000
# Car park and flood-alert refresh interval in milliseconds.
VITE_NEARBY_FEEDS_POLL_MS=120000
# Retry interval for feeds without a complete initial answer.
VITE_FEED_RETRY_MS=30000
# Shared footer/modal health refresh interval.
VITE_HEALTH_POLL_MS=300000
# Browser health request timeout; must exceed the server probe timeout.
VITE_HEALTH_TIMEOUT_MS=15000
# Speed readings older than this are labelled stale.
VITE_SPEED_STALE_MS=900000
# Camera captures older than this are labelled delayed.
VITE_CAMERA_STALE_MS=900000
# Air-quality readings older than this are labelled stale.
VITE_AIR_STALE_MS=10800000
# Lightning observations older than this are labelled stale.
VITE_LIGHTNING_STALE_MS=1800000
# Maximum age of locally retained fallback speeds.
VITE_SPEED_SNAPSHOT_MAX_AGE_MS=86400000
# Wall display checkpoint/tab cycling interval.
VITE_WALL_CYCLE_MS=30000
# Enable the existing browser-side vehicle counting; disabling avoids loading its model/runtime.
VITE_VEHICLE_COUNTING_ENABLED=true

# --- development settings ---
# Local dev/preview bind host; default preserves existing LAN access.
DEV_HOST=0.0.0.0
# Local dev port. CLI --port explicitly overrides this setting.
DEV_PORT=3100
# Local production-preview port.
PREVIEW_PORT=4173
# Disable HMR and file watching when true.
DISABLE_HMR=false

# --- tools settings ---
# Trusted OpenStreetMap Overpass endpoint for the offline base-map generator.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
# Base-map generator request timeout.
OVERPASS_TIMEOUT_MS=180000
# Base-map generator request attempts.
OVERPASS_MAX_ATTEMPTS=4
# Base-map generator linear retry backoff.
OVERPASS_RETRY_MS=20000

# --- ci settings ---
# Trusted health URL: Actions sends the bypass secret here. Empty derives from VITE_SITE_URL + /api/health.
PRODUCTION_HEALTH_URL=
# GitHub health-check delay before the second attempt.
HEALTHCHECK_RETRY_DELAY_MS=90000
# GitHub health-check HTTP timeout.
HEALTHCHECK_TIMEOUT_MS=60000

# Platform-owned: NODE_ENV is set by Vite/Node; do not copy it into local overrides.
# Vercel also injects public VITE_VERCEL_* deployment/Git/observability metadata; no local assignments are needed.
# CI ONLY: add VERCEL_AUTOMATION_BYPASS_SECRET as a GitHub Actions secret. It is never app/browser config.
# Health variables above are GitHub Actions repository variables when used by the scheduled workflow.
