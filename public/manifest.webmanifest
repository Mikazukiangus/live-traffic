  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f7f2e7",
  "theme_color": "#1f5a7a",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Live Traffic", "url": "/?page=radar&tab=expressways", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Checkpoint cameras", "url": "/?page=cameras", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Rain & air quality", "url": "/?page=radar&tab=weather", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
